# =================================================================
# 1. Firebase Realtime Database
# =================================================================
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"

# =================================================================
# 2. Free AI Providers (Choose ANY one — 100% Free Tiers Available)
# =================================================================

# Option 1 (RECOMMENDED - Most Generous Free Limits): Google Gemini API
# Get your free key in 30 seconds at: https://aistudio.google.com/app/apikey
# Free limits: 15 requests/min, 1,500 requests/day, NO credit card needed.
GEMINI_API_KEY="your-gemini-api-key-here"

# Option 2 (Ultra-Fast Free Tier): Groq Cloud API
# Get your free key at: https://console.groq.com/keys
# Free limits: 30 requests/min, 14,400 requests/day, NO credit card needed.
# GROQ_API_KEY="your-groq-api-key-here"

# Option 3 (OpenAI / OpenRouter API)
# OPENAI_API_KEY="your-openai-api-key-here"
