# =================================================================
# NewsDecodedAI — Environment Configuration Template
# =================================================================

# Database URL for Prisma (SQLite by default, or PostgreSQL/MySQL for production)
DATABASE_URL="file:./db/custom.db"

# Optional: NextAuth Secret (if custom NextAuth session encryption is configured)
# NEXTAUTH_SECRET="your-nextauth-secret-key-here"
# NEXTAUTH_URL="http://localhost:3000"

# Optional: AI Summarization / Ingestion API Keys (for live news pipeline)
# OPENAI_API_KEY="your-openai-api-key"
# NEWS_API_KEY="your-news-api-key"
